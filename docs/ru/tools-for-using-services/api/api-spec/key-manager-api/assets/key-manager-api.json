      "KeyDataKeyRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "context": {
            "type": "string",
            "format": "byte",
            "description": "Контекст для вывода ключа (base64). Обязателен если ключ создан с derived=true"
          },
          "nonce": {
            "type": "string",
