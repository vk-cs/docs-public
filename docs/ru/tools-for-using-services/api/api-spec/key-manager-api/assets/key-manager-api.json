          },
          "min_encryption_version": {
            "type": "integer",
            "nullable": true,
            "minimum": 0,
            "description": "Минимальная версия ключа, которой разрешено шифровать. Должна быть 0\n(использовать последнюю версию) либо не меньше min_decryption_version, и не\nменьше min_available_version. null равнозначен 0\n"
          },
