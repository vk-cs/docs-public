          },
          "key_version": {
            "type": "integer",
            "description": "Версия ключа, на которую перешифровать. По умолчанию последняя"
          },
          "nonce": {
            "type": "string",
            "format": "byte",
            "description": "Nonce (base64). Необходим, если был указан при шифровании"
          },
          "batch_input": {
            "type": "array",
