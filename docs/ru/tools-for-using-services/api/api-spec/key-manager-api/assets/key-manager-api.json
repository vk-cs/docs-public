          },
          "context": {
            "type": "string",
            "format": "byte",
            "description": "Контекст для вывода ключа (base64). Обязателен если ключ создан с derived=true"
          },
          "key_version": {
            "type": "integer",
            "description": "Версия ключа, на которую перешифровать. По умолчанию последняя"
          },
          "nonce": {
            "type": "string",
            "format": "byte",
